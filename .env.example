# ====================================================================
# MultiDoc RAG Assistant: Environment Configuration Template
# ====================================================================
# Rename this file to `.env` or set these environment variables in your deployment environment.

# 1. Hugging Face Inference API Token
# Paste your personal Hugging Face access token below:
HUGGINGFACE_API_TOKEN=your_hf_token_here

# 2. Text Generation & Chatbot Model (Open-Source Hugging Face Model)
# Using Qwen 2.5 7B Instruct via Hugging Face Serverless / Router API
TEXT_GENERATION_MODEL=Qwen/Qwen2.5-7B-Instruct

# 3. Dense Embedding Model (Open-Source Sentence Transformer)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 4. Vision & Image Captioning Model
IMAGE_MODEL=Salesforce/blip-image-captioning-large

# 5. Security & Authentication
SECRET_KEY=university-internship-multimodal-rag-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 6. Fallback Settings (Guarantees 100% Uptime even if API hits cold-starts)
ENABLE_LOCAL_FALLBACK=true
MOCK_EXTERNAL_APIS_IF_NO_KEY=false
